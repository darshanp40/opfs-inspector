{
  "name": "opfs-inspector",
  "version": "0.1.0",
  "private": true,
  "description": "Browse and edit a site's origin private file system, including Storage Buckets, from the developer tools.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-timeout=150000 'test/*.test.mjs'",
    "package": "npm run build && sh scripts/package.sh",
    "lint:firefox": "web-ext lint --source-dir . --ignore-files 'test/**' 'scripts/**' 'node_modules/**' 'dist/**' 'panel/**' 'package*.json' '*.md'"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "^18.1.3",
    "playwright": "1.56.0",
    "web-ext": "^8.10.0"
  }
}
