{
  "manifest_version": 3,
  "name": "OPFS Inspector",
  "version": "0.1.0",
  "description": "Browse and edit a site's origin private file system, including Storage Buckets, from the developer tools.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ]
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "opfs-inspector@darshanp40.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
